{
  // Shared compiler options for every package under packages/. A package's own tsconfig.json extends this
  // file, sets rootDir/outDir and adds "types": ["node"] only when it runs on Node - core and srs also run
  // in the browser, so Node types are not visible there by default.
  //
  // TypeScript is pinned to 6.0.x: typescript-eslint supports TypeScript below 6.1, so the native
  // TypeScript 7 waits until it does.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Workspace packages resolve to each other's TypeScript sources through this export condition, so the
    // type-aware ESLint run and the editor never depend on a stale or missing dist/. Node ignores it and
    // loads dist/, and tsc -b swaps the sources of a referenced project for its emitted declarations.
    "customConditions": ["@wastech-learn/source"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": []
  }
}
