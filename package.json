{
  "name": "wastech-learn",
  "version": "0.0.0",
  "private": true,
  "description": "Personal spaced-repetition learning framework: the headless core (schemas, check, content bundle, FSRS replay and queue, the review session), the CLI, the MCP server, the local server and the app.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint:code && npm run lint:docs",
    "lint:code": "npm run lint:es && npm run lint:css && npm run format:check && npm run typecheck && npm run lint:dashes",
    "lint:es": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:dashes": "node scripts/check-dashes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && ngc -p packages/app/tsconfig.json",
    "build": "tsc -b && npm run build -w @wastech-learn/app",
    "app:dev": "npm run start -w @wastech-learn/app",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fix": "node scripts/fix.mjs",
    "lint:docs": "wastech-mdlint lint .",
    "lint:docs:fix": "wastech-mdlint lint . --fix",
    "docs:graph": "wastech-mdlint graph .",
    "docs:view": "wastech-mdlint-viewer",
    "proto:data": "node prototypes/desktop-ui/build-data.mjs ../wastech-learn-content"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.19.4",
    "@wastech-mdlint/cli": "0.4.1",
    "@wastech-mdlint/core": "0.4.1",
    "@wastech-mdlint/mcp-server": "0.4.1",
    "@wastech-mdlint/viewer": "0.4.1",
    "angular-eslint": "22.8.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "hast-util-to-html": "9.0.7",
    "mdast-util-to-hast": "13.2.2",
    "prettier": "3.10.1",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "unist-util-visit": "5.2.0",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.62.0"
    }
  }
}
