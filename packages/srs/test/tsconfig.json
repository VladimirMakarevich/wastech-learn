{
  // Type-checks the tests against the package's emitted declarations; it emits only declarations into .cache/,
  // which tsc -b needs for a referenced project.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "outDir": "../../../.cache/tsc/srs-test"
  },
  "include": ["**/*.ts"],
  "references": [{ "path": "../tsconfig.json" }]
}
