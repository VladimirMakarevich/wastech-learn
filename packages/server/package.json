{
  "name": "@wastech-learn/server",
  "version": "0.0.0",
  "description": "The local server of wastech-learn: serves the app, the content bundle and the review log on 127.0.0.1, appends the app's events and tells the app about changes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladimirMakarevich/wastech-learn.git",
    "directory": "packages/server"
  },
  "type": "module",
  "exports": {
    ".": {
      "@wastech-learn/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.17.0"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@wastech-learn/content-fs": "0.0.0",
    "@wastech-learn/core": "0.0.0",
    "@wastech-learn/srs": "0.0.0",
    "hono": "4.13.22"
  }
